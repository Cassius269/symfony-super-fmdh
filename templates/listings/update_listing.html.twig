{% extends "base.html.twig" %}
{% block title %}Page de mise à jour d'une annonce immobilière{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('listingUpdatePage')}}
{% endblock %}
{% block body %}
{{ form_errors(form) }}
    {{ form_start(form) }}
        {{ form_row(form.title)}}
        {{ form_row(form.description) }}
        {{ form_row(form.price) }}
        {{ form_row(form.image) }}
        {{ form_row(form.city) }}
        {{ form_row(form.propertyType) }}
        {{ form_row(form.transactionType) }}

        <input type="submit" class="form-control btn btn-primary mt-3 text-white p-3" value="Mettre à jour l'annonce">
    {{ form_end(form) }}
{% endblock %}