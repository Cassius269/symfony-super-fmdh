{# Lire et afficher tous les messages flash #}
{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="flash-{{ label }} text-white text-center p-3 {% if label =='success' %} bg-primary {% else %} bg-danger {% endif %} ">
            {{ message }}
        </div>
    {% endfor %}
{% endfor %}