<article class="card col-lg-3" style="height: 551px;">
    <img src="{{ listing.image }}" alt="image d'illustration de l'annonce">
        <div>{{ listing.transactionType.name}}</div>
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
           <h5 class="card-title">{{ listing.title }}</h2>
            {% if listing.transactionType.name == 'location' %}
                <p class="card-text fst-italic">{{ listing.price }} €/mois</p>

            {% elseif listing.transactionType.name == 'vente' %}
                <p class="card-text fst-italic">{{ listing.price }} €</p>                
            {% endif %}
        </div>
        <p class="card-text">{{ listing.city.name }}</p>
        <p class="card-text">{{ listing.description }}</p>
        <a href="{{ path('listings_show', { id: listing.id })}}">
            <button class="btn btn-primary">Regarder en détail</button>
        </a>
     </div>
</article>
