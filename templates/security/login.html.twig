{% extends 'base.html.twig' %}

{% block title %} Page de connexion {% endblock %}

{% block body %}
     <h2 class="mb-5"> Se connecter sur Find My Dream Homee</h2>
        <form action="{{ path('login')}}" method="POST" class="w-50 bg-secondary m-auto p-5 rounded">
            <div>
                <label for="email" class="form-label">Identifiant</label>
                <input type="email" id="email" name="_username" required class="form-control" value="{{ username }}">
            </div>
            <div class="mt-3">
                <label for="password" class="form-label">Mot de passe</label>
                <input type="password" id="password" name="_password" required class="form-control">               
            </div>

            <input type="submit" value="Me connecter" class="btn btn-primary mt-3">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate')}}">
            {% if error %}
                <div>{{ error.messageKey|trans(error.messageData, 'security') }}</div>
             {% endif %}
        </form>
        <button type="button" class="btn btn-secondary d-block m-auto mt-4"><a href="{{ path('register') }}" class="text-white">Pas encore de compte ? Inscrivez-vous</a></button>

{% endblock %}
